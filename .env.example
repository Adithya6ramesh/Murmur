# ─────────────────────────────────────────────────────────
# Murmur AI Voice Journaling App — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env itself.
# ─────────────────────────────────────────────────────────

# ── Flask ──────────────────────────────────────────────
# "development" uses debug mode; "production" enforces SECRET_KEY and disables debug.
FLASK_ENV=development

# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Google Gemini ──────────────────────────────────────
# Server-side Gemini key (preferred). Leave blank if clients supply their own.
GEMINI_API_KEY=

# ── Upload limits ──────────────────────────────────────
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Max chars accepted by the text-analysis and ask endpoints.
MAX_TEXT_LENGTH=50000
MAX_JOURNAL_CONTEXT_LENGTH=120000

# ── CORS ───────────────────────────────────────────────
# Comma-separated origins. Use * ONLY for local dev.
# Production example: MURMUR_CORS_ORIGINS=https://app.example.com
MURMUR_CORS_ORIGINS=http://localhost:5173

# ── Optional API gate ─────────────────────────────────
# If set, every request must carry Authorization: Bearer <token> or X-Murmur-Api-Key.
# Prefer the SHA-256 form so your .env never holds the raw token.
# MURMUR_API_SECRET=
# MURMUR_API_SECRET_SHA256=
# MURMUR_PROTECT_HEALTH=false

# ── OpenAI Whisper (speech-to-text) ───────────────────
# Checkpoint name for pip package openai-whisper (e.g. tiny, base, small, small.en).
WHISPER_MODEL_NAME=small.en

# ── Server ─────────────────────────────────────────────
HOST=127.0.0.1
PORT=5001
